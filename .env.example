# ==============================================================
# PlanCraft Environment Configuration (Template)
# Salin file ini menjadi .env.local untuk development
# atau .env untuk di server production
# ==============================================================

# Port aplikasi Next.js (default: 3000)
PORT=3000

# Mode aplikasi ('development' untuk lokal, 'production' untuk server)
NODE_ENV=production

# Identitas Aplikasi
NEXT_PUBLIC_APP_NAME="PlanCraft"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ID Google Sheet Master SKU Database PlanCraft
# Format URL: https://docs.google.com/spreadsheets/d/1Dpe2Z8s3OcAJVN65vjGr2E_C2gR3UBPe946kG1GLR28/edit
NEXT_PUBLIC_DEFAULT_GSHEET_ID="1Dpe2Z8s3OcAJVN65vjGr2E_C2gR3UBPe946kG1GLR28"

# ==============================================================
# Keamanan & PIN Akun Pengguna (Wajib di Production / PM2)
# ==============================================================
# PIN untuk akun 'admin' (Admin PPIC). Dilarang memakai 1234 di production!
ADMIN_PIN=

# PIN untuk akun 'produksi' (Tim Produksi). Dilarang memakai 1234 di production!
PRODUCTION_PIN=
